%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   4 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "P"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "thrusttoVel:10:150-151"\
      Dimensions   [2,2]\
    }\
    ChartData {\
      Name         "v_est"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "thrusttoVel:10:152-157"\
    }\
    ChartData {\
      Name         "bias_est"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "thrusttoVel:10:158-166"\
    }\
    ChartData {\
      Name         "x_est"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "thrusttoVel:10:167-172"\
    }\
  }
  %return ChartDataElements
%endfunction
